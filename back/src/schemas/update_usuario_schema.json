{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpdateUsuarioSchema",
  "type": "object",
  "properties": {
    "user": {
        "type": "string"
    },
    "email": {
        "type": "string",
        "format": "email"
    },
    "password": {
        "type": "string",
        "minLength": 6
    },
    "newPassword": {
        "type": "string",
        "minLength": 6
    },
    "confirmPassword": {
        "type": "string",
        "minLength": 6
    }
  },
  "required": ["user",
    "email",
    "password",
    "newPassword",
    "confirmPassword"
  ]
}